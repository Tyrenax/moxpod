{
  "name": "moxpod",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "MoxPod browser extension — spectate opponent boards in Moxfield playtest",
  "scripts": {
    "build": "node build.js",
    "build:chrome": "node build.js chrome",
    "build:firefox": "node build.js firefox",
    "watch": "node build.js --watch",
    "test": "node --test tests/*.test.js",
    "test:unit": "node --test tests/*.test.js",
    "test:build": "node build.js && node --test tests/build/build-smoke.test.js",
    "test:e2e": "node build.js chrome && playwright test",
    "test:firefox-lint": "node build.js firefox && web-ext lint --source-dir dist/firefox --self-hosted",
    "relay": "node server/dev-relay.js",
    "relay:verbose": "node server/dev-relay.js --verbose",
    "relay:lossy": "node server/dev-relay.js --verbose --latency 150 --loss 0.05",
    "relay:slow": "node server/dev-relay.js --verbose --rate 1",
    "dev": "node build.js chrome --watch",
    "package": "node package.js",
    "version": "node sync-version.js && git add manifests/base.json",
    "release": "echo \"npm version patch|minor|major, puis: git push origin main --follow-tags\""
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "esbuild": "^0.25.0",
    "web-ext": "^10.1.0"
  }
}
