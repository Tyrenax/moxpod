{
  "manifest_version": 3,
  "name": "MoxMox",
  "version": "0.1.0",
  "author": "Nate Finch",
  "homepage_url": "https://github.com/natefinch/moxmox",
  "description": "MoxMox browser extension",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/moxmox-16.png",
    "32": "icons/moxmox-32.png",
    "48": "icons/moxmox-48.png",
    "128": "icons/moxmox-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/moxmox-16.png",
      "32": "icons/moxmox-32.png",
      "48": "icons/moxmox-48.png",
      "128": "icons/moxmox-128.png"
    },
    "default_popup": "popup.html",
    "default_title": "MoxMox"
  }
}
