{
  "manifest_version": 3,
  "name": "MoxPod",
  "version": "0.1.2",
  "author": "Tyrenax",
  "homepage_url": "https://github.com/Tyrenax/moxpod",
  "description": "MoxPod ajoute aux parties Commander de Moxfield la vue du board des adversaires : un joueur affiché à la fois, avec ses marqueurs, ses modificateurs de force/endurance, sa vie, son cimetiere et son exil. Fork de MoxMox (Nate Finch).",
  "permissions": [
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8787/*",
    "https://api.github.com/*",
    "https://*.workers.dev/*",
    "https://archidekt.com/*",
    "http://localhost:*/*",
    "https://cards.scryfall.io/*",
    "https://api.scryfall.com/*"
  ],
  "icons": {
    "16": "icons/moxmox-16.png",
    "32": "icons/moxmox-32.png",
    "48": "icons/moxmox-48.png",
    "64": "icons/moxmox-64.png",
    "128": "icons/moxmox-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://moxfield.com/*",
        "https://archidekt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css",
        "moxpod.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://moxfield.com/*",
        "https://archidekt.com/*"
      ],
      "js": [
        "content-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/moxmox-16.png",
      "32": "icons/moxmox-32.png",
      "48": "icons/moxmox-48.png",
      "64": "icons/moxmox-64.png",
      "128": "icons/moxmox-128.png"
    },
    "default_popup": "popup.html",
    "default_title": "MoxPod"
  }
}
