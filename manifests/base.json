{
  "manifest_version": 3,
  "name": "MoxMox",
  "version": "1.1.0",
  "author": "Nate Finch",
  "homepage_url": "https://github.com/natefinch/moxmox",
  "description": "MoxMox lets you play DanDan style shared deck games right in moxfield's playtest mode. It also augments using moxfield's playtest mode for commander games, letting you see your opponent's hand size, pass control of cards to them, and easily view their graveyard, or show them your hand secretly.",
  "permissions": [
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8787/*",
    "https://api.github.com/*",
    "https://*.workers.dev/*"
  ],
  "icons": {
    "16": "icons/moxmox-16.png",
    "32": "icons/moxmox-32.png",
    "48": "icons/moxmox-48.png",
    "64": "icons/moxmox-64.png",
    "128": "icons/moxmox-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://moxfield.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://moxfield.com/*"
      ],
      "js": [
        "content-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/moxmox-16.png",
      "32": "icons/moxmox-32.png",
      "48": "icons/moxmox-48.png",
      "64": "icons/moxmox-64.png",
      "128": "icons/moxmox-128.png"
    },
    "default_popup": "popup.html",
    "default_title": "MoxMox"
  }
}
